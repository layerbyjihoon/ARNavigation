<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

  <android.opengl.GLSurfaceView
      android:id="@+id/surfaceview"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />
  <com.google.ar.core.examples.java.helloar.debug.SegmentationDebugOverlay
      android:id="@+id/semantic_overlay" android:layout_width="match_parent"
      android:layout_height="match_parent" android:clickable="false" android:focusable="false" />

  <LinearLayout android:id="@+id/ar_header"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_alignParentTop="true" android:layout_margin="16dp"
      android:background="@drawable/nav_ar_panel" android:orientation="vertical"
      android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:text="@string/nav_ar_title"
          android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
      <Button android:id="@+id/ar_tools_toggle" style="@style/NavButton.Secondary"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginStart="8dp" android:text="@string/nav_tools_open" />
    </LinearLayout>
    <TextView android:id="@+id/navigation_start_location"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@android:color/white"
        android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/navigation_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/nav_status_tracking"
        android:textColor="@color/nav_ar_text" android:textSize="14sp" />
    <TextView android:id="@+id/dataset_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/ar_live_mode"
        android:textColor="@android:color/white" android:textSize="13sp" android:visibility="gone" />
  </LinearLayout>

  <LinearLayout android:id="@+id/ar_actions"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_alignParentBottom="true" android:layout_margin="16dp"
      android:background="@drawable/nav_panel" android:orientation="horizontal" android:padding="10dp">
    <Button android:id="@+id/map_route_button" style="@style/NavButton.Secondary"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginEnd="8dp" android:text="@string/map_open" />
    <Button android:id="@+id/start_nav_button" style="@style/NavButton.Primary"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:enabled="false" android:text="@string/nav_start_sample" />
  </LinearLayout>

  <ScrollView android:id="@+id/ar_tools_panel"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_below="@id/ar_header" android:layout_above="@id/ar_actions"
      android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp"
      android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/nav_ar_panel" android:orientation="vertical" android:padding="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="@string/ar_developer_label" android:textColor="@android:color/white"
          android:textSize="16sp" android:textStyle="bold" />
      <Button android:id="@+id/calibrate_button" style="@style/NavButton.Secondary"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="10dp" android:text="@string/navigation_calibrate" />
      <Button android:id="@+id/reset_nav_button" style="@style/NavButton.Secondary"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="8dp" android:text="@string/navigation_reset" />
      <LinearLayout android:id="@+id/dataset_controls"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="8dp" android:orientation="vertical">
        <TextView android:id="@+id/recording_start_point" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/nav_ar_text"
            android:textSize="13sp" android:visibility="gone" />
        <Button android:id="@+id/record_ar_button" style="@style/NavButton.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ar_record_start" />
        <Button android:id="@+id/recordings_button" style="@style/NavButton.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/ar_recordings" />
        <Button android:id="@+id/stop_playback_button" style="@style/NavButton.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:visibility="gone" android:text="@string/ar_playback_stop" />
      </LinearLayout>
      <CheckBox android:id="@+id/semantic_enable" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:checked="true" android:text="@string/semantic_enable"
          android:textColor="@android:color/white" />
      <CheckBox android:id="@+id/semantic_correction" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:checked="true" android:text="@string/semantic_correction"
          android:textColor="@android:color/white" />
      <TextView android:id="@+id/semantic_model_state" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/semantic_loading" android:textColor="@android:color/white" />
      <CheckBox android:id="@+id/semantic_mask" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/semantic_mask" android:textColor="@android:color/white" />
      <CheckBox android:id="@+id/semantic_landmarks" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/semantic_landmarks" android:textColor="@android:color/white" />
      <CheckBox android:id="@+id/semantic_status" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/semantic_status" android:textColor="@android:color/white" />
      <CheckBox android:id="@+id/semantic_compare" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/semantic_compare" android:textColor="@android:color/white" />
      <TextView android:id="@+id/debug_text" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginTop="12dp"
          android:text="@string/navigation_initial" android:textColor="@color/nav_ar_text"
          android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>
  </ScrollView>
</RelativeLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/nav_search_sheet" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <com.google.android.material.button.MaterialButton android:id="@+id/close_search" style="@style/Widget.Material3.Button.TextButton" android:layout_width="36dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="‹" android:textSize="28sp" android:contentDescription="경로 변경 닫기" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="경로 변경" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/nav_ink" />
 </LinearLayout>
 <EditText android:id="@+id/route_search" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/nav_search_field" android:hint="건물 또는 장소 검색" android:textSize="16sp" android:textColor="@color/nav_ink" android:textColorHint="@color/nav_muted" android:singleLine="true" android:inputType="text" android:importantForAutofill="no" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" android:text="추천 목적지" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/nav_muted" />
 <ListView android:id="@+id/route_search_results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" />
 <TextView android:id="@+id/route_search_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="목적지를 검색해주세요." android:textSize="12sp" android:textColor="@color/nav_muted" android:gravity="center" android:accessibilityLiveRegion="polite" />
 <com.google.android.material.button.MaterialButton android:id="@+id/keep_route" style="@style/NavButton.Secondary" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:text="변경하지 않고 돌아가기" />
</LinearLayout>
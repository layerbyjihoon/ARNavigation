<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/destination_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/nav_ink"
            android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/destination_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/nav_muted" android:textSize="14sp"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/destination_primary_action" style="@style/NavButton.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/confirm_destination" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/destination_change_action" style="@style/NavButton.Secondary"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/change_destination" />
            <Button android:id="@+id/destination_retry_action" style="@style/NavButton.Secondary"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="@string/retry" />
        </LinearLayout>
    </LinearLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:focusableInTouchMode="true">
 <androidx.fragment.app.FragmentContainerView android:id="@+id/map_container" android:layout_width="match_parent" android:layout_height="match_parent" />
 <LinearLayout android:id="@+id/search_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/nav_search_field" android:gravity="center_vertical" android:orientation="horizontal">
   <com.google.android.material.button.MaterialButton android:id="@+id/search_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="56dp" android:minWidth="0dp" android:padding="0dp" android:text="☰" android:textSize="24sp" android:textColor="@color/nav_muted" android:contentDescription="메뉴 열기" />
   <EditText android:id="@+id/place_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:background="@null" android:paddingEnd="16dp" android:hint="건물 또는 장소 검색" android:textColor="@color/nav_ink" android:textColorHint="@color/nav_muted" android:textSize="16sp" android:importantForAutofill="no" android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true" />
  </LinearLayout>
  <TextView android:id="@+id/search_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" android:text="추천 검색어" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/nav_muted" android:visibility="gone" />
  <ProgressBar android:id="@+id/search_progress" style="?android:attr/progressBarStyleSmall" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
  <ListView android:id="@+id/place_suggestions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:visibility="gone" />
  <TextView android:id="@+id/search_helper" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="건물을 선택하면 경로를 확인할 수 있어요." android:textSize="12sp" android:textColor="@color/nav_muted" android:visibility="gone" />
 </LinearLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/final_choose_room" android:visibility="gone" style="@style/NavButton.Secondary" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="88dp" android:layout_marginEnd="16dp" android:text="문화관 강의실" />
 <com.google.android.material.button.MaterialButton android:id="@+id/current_location" style="@style/NavButton.Secondary" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="bottom|start" android:layout_margin="16dp" android:text="◎ 현재 위치" />
 <com.google.android.material.button.MaterialButton android:id="@+id/location_permission_button" style="@style/NavButton.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_margin="16dp" android:text="@string/enable_location" />
 <com.example.arnavigation.ui.map.DestinationCardView android:id="@+id/destination_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="16dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/nav_surface" app:strokeWidth="0dp" />
</FrameLayout>

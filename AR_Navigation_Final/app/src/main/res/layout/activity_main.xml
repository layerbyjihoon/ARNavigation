<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nav_background">

    <TextView
        android:id="@+id/configuration_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_soft"
        android:textColor="@color/nav_muted"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/api_configuration_checking"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/main_bottom_navigation"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_surface"
        android:contentDescription="@string/main_navigation_description"
        android:elevation="0dp"
        app:itemIconTint="@color/nav_tab_tint"
        app:itemTextColor="@color/nav_tab_tint"
        app:itemActiveIndicatorStyle="@style/NavActiveIndicator"
        app:menu="@menu/main_bottom_navigation" />

</LinearLayout>

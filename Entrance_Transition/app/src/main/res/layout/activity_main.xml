<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101820">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/target_building" android:textColor="#FFFFFF"
        android:textSize="22sp" android:padding="16dp" />
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.camera.view.PreviewView android:id="@+id/preview"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.example.entrancetransition.SegmentationOverlay android:id="@+id/segmentation"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/segmentation_legend" android:textColor="#FFFFFF"
        android:textSize="12sp" android:padding="8dp" />
    <TextView android:id="@+id/mode" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:text="@string/mode_unknown" android:textSize="44sp"
        android:textStyle="bold" android:textColor="#FFFFFF"
        android:padding="12dp" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/loading"
        android:textSize="16sp" android:textColor="#FFFFFF" android:padding="12dp" />
    <Button android:id="@+id/permission" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="@string/permission_button" android:visibility="gone" />
    <Button android:id="@+id/rescan" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="@string/rescan" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/scope_hint" android:textColor="#BAC6D0"
        android:textSize="12sp" android:padding="8dp" />
</LinearLayout>
